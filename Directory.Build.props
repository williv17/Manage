<Project>
  <PropertyGroup>
    <!-- Language and compiler settings -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Shared metadata -->
    <Company>GetBitSoftware</Company>
    <Authors>WV</Authors>
    <Version>1.0.0</Version>

    <!-- Default target framework for class libraries -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>

    <!-- Consistent debug behavior -->
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>

    <!-- Optional: Default output paths -->
    <!-- <BaseOutputPath>$(SolutionDir)build\</BaseOutputPath> -->
    <!-- <BaseIntermediateOutputPath>$(SolutionDir)obj\</BaseIntermediateOutputPath> -->
  </PropertyGroup>
</Project>